# Copy this to terraform.tfvars and fill in your project id.
# terraform.tfvars is gitignored, .example is not.

project_id = "your-gcp-project-id"
region     = "us-central1"

# Leave 'image' unset on the first apply so you get the placeholder hello
# container and can confirm the plumbing works. Once you've pushed Shelby
# to Artifact Registry, uncomment and set:
#
# image = "us-central1-docker.pkg.dev/your-gcp-project-id/shelby/shelby:latest"

# Optional overrides:
# service_name = "shelby"
# shelby_model = "claude-opus-4-7"
